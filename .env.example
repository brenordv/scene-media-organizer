# Infisical bootstrap: the machine identity that reads this app's secrets (see readme, "Configuration").
INFISICAL_HOST=https://infisical.example.com
INFISICAL_ENV=dev
INFISICAL_MEDIA_ORGANIZER_CLIENT_ID=your-machine-identity-client-id
INFISICAL_MEDIA_ORGANIZER_CLIENT_SECRET=your-machine-identity-client-secret
INFISICAL_MEDIA_ORGANIZER_PROJECT_ID=your-infisical-project-id

# Folders (in the container these are the mount points).
WATCH_FOLDER=/watch
MOVIES_BASE_FOLDER=/movies
SERIES_BASE_FOLDER=/series

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional tuning.
# MQTT_BASE_TOPIC=notifications
# MQTT_CLIENT_ID=
# ACTIVITY_DB_LOG_LEVEL=INFO
# TELEGRAM_PARSE_MODE=HTML
# TELEGRAM_DISABLE_WEB_PREVIEW=false
# TELEGRAM_DISABLE_NOTIFICATION=false
# WATCHDOG_CHANGE_DEST_OWNERSHIP_ON_COPY=false
# WATCHDOG_COPY_USING_RSYNC=false
# UNRAR_PATH=7zz
